# Copy to app/.env.local for `npm start -w app` and `npx expo run:ios` (never commit real values).
# Vercel: set the same two variables in the project's Production (and Preview) environment.
# iOS builds on EAS read them from the EAS environment named in the build profile (eas.json):
# development and preview hold the dev backend's values, production the prod backend's.
#
# Supabase → Project Settings → API: the project URL and the *publishable* key (sb_publishable_…, or
# the legacy anon key). Never the secret / service_role key: these values ship to every browser.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# The Map tab (BEV-22): Google Maps JavaScript API, Bev Maps' Google Cloud project (D-12). The
# parked venue map (M-16) reads the same two.
# The key is a *browser* key: it ships to every browser, so restrict it in Cloud Console to HTTP
# referrers and to the Maps JavaScript API only. THE REFERRERS MUST INCLUDE THIS APP'S ORIGINS: the
# Vercel domain and http://localhost:8081/* for `npm start`. A key that allows only another site's
# origins is rejected at load (RefererNotAllowedMapError), and the Map tab then shows its places
# as a list with a note instead of the map.
# The Map ID is Bevi's vector, cloud-styled map (muted, POI-free); Advanced Markers need one. With
# no Map ID the app falls back to Google's DEMO_MAP_ID, which is only fit for localhost. With no
# key the Map tab is the list of places, and everything else works.
#
# Not here, because it is a secret and never reaches a browser: the place picker's "search more
# places" uses a second, server-side key with the Places API (New) enabled, set on the Supabase
# project as GOOGLE_PLACES_API_KEY (`supabase secrets set`; supabase/functions/places).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAP_ID=

# The deploy's git commit, shown as "Build" in an internal bug report so a ticket says which deploy
# it was filed from. Not a secret (the repository is public). Leave it empty locally: the Vercel
# build sets it from VERCEL_GIT_COMMIT_SHA (app/vercel.json), and a build without it just omits it.
EXPO_PUBLIC_BUILD_SHA=

# Standalone demo instead of the app shell, development builds only. Never bypasses sign-in in production.
# EXPO_PUBLIC_NUTRITION_SCAN_DEMO=1
