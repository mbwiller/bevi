# Copy to app/.env.local for `npm start -w app` (never commit real values). Vercel: set the same two
# variables in the project's Production (and Preview) environment.
#
# Supabase → Project Settings → API: the project URL and the *publishable* key (sb_publishable_…, or
# the legacy anon key). Never the secret / service_role key: these values ship to every browser.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
