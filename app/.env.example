# Copy to app/.env.local for `npm start -w app` (never commit real values). Vercel: set the same two
# variables in the project's Production (and Preview) environment.
#
# Supabase → Project Settings → API: the project URL and the *publishable* key (sb_publishable_…, or
# the legacy anon key). Never the secret / service_role key: these values ship to every browser.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# The Search tab's map (M-16): Google Maps JavaScript API, Bev Maps' Google Cloud project (D-12).
# The key is a *browser* key: it ships to every browser, so restrict it in Cloud Console to HTTP
# referrers (the Vercel domain and http://localhost:8081/*) and to the Maps JavaScript API only.
# The Map ID is Bevi's vector, cloud-styled map (muted, POI-free); Advanced Markers need one. With
# no Map ID the app falls back to Google's DEMO_MAP_ID, which is only fit for localhost. With no
# key the map area says "Map unavailable right now" and everything else works.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAP_ID=
