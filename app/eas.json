{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_VARIANT": "development", "EXPO_PUBLIC_BEVI_API": "mock" }
    },
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_BEVI_API": "supabase" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_BEVI_API": "supabase" }
    }
  },
  "submit": {
    "production": {}
  }
}
