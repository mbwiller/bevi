# Expo
.expo/
dist/
web-build/
expo-env.d.ts
# Continuous Native Generation: ios/ and android/ are generated by `expo prebuild` / EAS.
# Anchored with a leading slash so they mean app/ios and app/android and nothing else.
# Unanchored, `ios/` matches a directory called `ios` at ANY depth, which silently
# swallowed the native half of the local Expo module in app/modules/ -- `git add` skipped
# the Swift and the podspec without a word, and the module would have been committed
# unbuildable. Keep the slashes.
/ios/
/android/
.metro-health-check*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
