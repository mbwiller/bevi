# Copy to supabase/.env (gitignored) for local Edge Functions and the graph
# scripts. Never commit real values. In the hosted project the same names are
# set with `supabase secrets set`; in CI they are GitHub Actions secrets.
#
# What each one is for, the Aura pause/delete rules and how to resume a paused
# instance: docs/graph.md.

# Neo4j AuraDB Free (A-15). The Bolt URI from the credentials file Aura shows
# exactly once at instance creation; apply-schema.ts and graph-query derive the
# Query API URL from its host.
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
# Optional. Aura Free has a single database called `neo4j`, which is the default.
NEO4J_DATABASE=neo4j

# A-16 (1), the embedding half -- no Neo4j involved. SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY are injected into deployed Edge Functions, so these
# two are for `supabase functions serve` and for
# `npm run graph:backfill-embeddings`. The service-role key is a secret: it
# reads past RLS and authorises `embed`. Never commit a value.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# REQUIRED, random and rotatable. The bearer token the `embed` Edge Function
# checks itself (it has verify_jwt = false; see docs/graph.md). It is
# deliberately NOT allowed to default to the service-role key: pg_net persists
# the trigger's whole request, headers included, as a row in
# net.http_request_queue, so the token sits at rest in a database table. A
# token that can only ask for an embedding is a fine thing to leave there; a
# key that bypasses RLS on every table is not. The same value must be set in
# three places: here, `supabase secrets set`, and the database setting
# `bevi.embed_webhook_token` for the `bevs` trigger.
EMBED_WEBHOOK_SECRET=
# Optional. Defaults to <SUPABASE_URL>/functions/v1/embed.
EMBED_FUNCTION_URL=

# The same two variables also drive the bev_edges builder
# (`npm run graph:edges`, scripts/graph/build-edges.ts), which reads Postgres
# and writes Postgres with no Neo4j involved. In CI they are the SUPABASE_URL
# repository *variable* (the REST origin is not a secret) and the
# SUPABASE_SERVICE_ROLE_KEY repository *secret*; that job exits 1 naming
# whichever is missing rather than skipping quietly, the way graph-keepalive
# did for eight days.

# A-16 only (the Neo4j sync, not yet built). The HMAC salt behind the stable
# (:User {pseudonym}) in the graph -- changing it orphans every RANKED edge, so
# it is set once and kept. Lives in GitHub Actions secrets, never in an Edge
# Function and never anywhere packages/api or app/ can reach.
BEVI_PSEUDONYM_SALT=
