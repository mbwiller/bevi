# Copy to supabase/.env (gitignored) for local Edge Functions and the graph
# scripts. Never commit real values. In the hosted project the same names are
# set with `supabase secrets set`; in CI they are GitHub Actions secrets.
#
# What each one is for, the Aura pause/delete rules and how to resume a paused
# instance: docs/graph.md.

# Neo4j AuraDB Free (A-15). The Bolt URI from the credentials file Aura shows
# exactly once at instance creation; apply-schema.ts and graph-query derive the
# Query API URL from its host.
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
# Optional. Aura Free has a single database called `neo4j`, which is the default.
NEO4J_DATABASE=neo4j

# A-16 only (the nightly sync, not yet built). The HMAC salt behind the stable
# (:User {pseudonym}) in the graph -- changing it orphans every RANKED edge, so
# it is set once and kept. Lives in GitHub Actions secrets, never in an Edge
# Function and never anywhere packages/api or app/ can reach.
BEVI_PSEUDONYM_SALT=
