{
  "name": "bevi",
  "private": true,
  "workspaces": [
    "app",
    "packages/ranking",
    "packages/api",
    "shared"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck:scripts",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "test": "npm run test --workspaces --if-present && npm run test:scripts",
    "test:scripts": "node --experimental-strip-types --test scripts/graph/*.test.ts",
    "catalog:validate": "node --experimental-strip-types scripts/catalog/validate.ts",
    "catalog:migration": "node --experimental-strip-types scripts/catalog/build-seed-migration.ts",
    "graph:schema": "node --experimental-strip-types scripts/graph/apply-schema.ts",
    "graph:keepalive": "node --experimental-strip-types scripts/graph/keepalive.ts",
    "graph:backfill-embeddings": "node --experimental-strip-types scripts/graph/backfill-embeddings.ts",
    "graph:edges": "node --experimental-strip-types scripts/graph/build-edges.ts",
    "graph:verify": "node --experimental-strip-types scripts/graph/verify-pipeline.ts"
  },
  "overrides": {
    "react": "19.2.3"
  }
}
