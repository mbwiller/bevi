{
  "version": "1.1.0",
  "constants": {
    "version": "1.1.0",
    "bands": {
      "DISLIKED": [
        0,
        4
      ],
      "FINE": [
        4,
        7
      ],
      "LOVED": [
        7,
        10
      ]
    },
    "bucketOrder": [
      "LOVED",
      "FINE",
      "DISLIKED"
    ],
    "bucketDb": {
      "LOVED": 3,
      "FINE": 2,
      "DISLIKED": 1
    },
    "sigmaFloor": 1,
    "minNUser": 3,
    "minNCat": 3,
    "globalFallback": {
      "mean": 5,
      "stddev": 2.5
    },
    "kAff": 2,
    "bayesC": 3,
    "bayesCategoryPriorMin": 30,
    "minRaters": 2,
    "kG": 3,
    "rankPointsWeights": {
      "bevsRanked": 1,
      "currentStreak": 3,
      "bevsCreated": 2
    },
    "streakPeriod": "day",
    "simWeights": {
      "category": 0.4,
      "brand": 0.3,
      "flavor": 0.2,
      "tier": 0.1
    },
    "simMin": 0.1,
    "layer1Weights": {
      "affinity": 0.4,
      "content": 0.4,
      "global": 0.2
    },
    "conf1UserN": 10,
    "conf1Mass": 4,
    "cfK": 10,
    "cfMinCommon": 2,
    "cfSignificance": 5,
    "lambdaMax": 0.7,
    "lambdaUserN": 15,
    "epsilon": 0.15,
    "jitterSd": 0.15,
    "storedScoreRule": "cents = floor((2N + D) / (2D)) with D = n + 1, N = 100*(hi*D - (hi - lo)*(index + 1)); capped at hi*100 - 1 for FINE and DISLIKED; storedScore = cents / 100",
    "stddev": "population (stddev_pop)",
    "nameOrder": "code point (SQL collate \"C\"), then bevId",
    "streakDayKey": "calendar date of the ranking instant in the profile timezone: (created_at AT TIME ZONE timezone)::date; week = ISO week of that date (YYYY-Www)",
    "rankOrder": "points desc, bevsRanked desc, createdAt asc, userId asc; rank = 1 + count(points > mine); bevsRanked = 0 excluded"
  },
  "cases": [
    {
      "name": "LA 23:59 PDT stays on the local day",
      "fn": "localDayKey",
      "input": {
        "isoTimestamp": "2026-10-11T06:59:00Z",
        "timeZone": "America/Los_Angeles"
      },
      "expected": "2026-10-10"
    },
    {
      "name": "LA 00:00 PDT starts the next day",
      "fn": "localDayKey",
      "input": {
        "isoTimestamp": "2026-10-11T07:00:00Z",
        "timeZone": "America/Los_Angeles"
      },
      "expected": "2026-10-11"
    },
    {
      "name": "LA 23:59 PST the night clocks spring forward",
      "fn": "localDayKey",
      "input": {
        "isoTimestamp": "2026-03-08T07:59:00Z",
        "timeZone": "America/Los_Angeles"
      },
      "expected": "2026-03-07"
    },
    {
      "name": "LA 23:59 PDT on the 23-hour day",
      "fn": "localDayKey",
      "input": {
        "isoTimestamp": "2026-03-09T06:59:00Z",
        "timeZone": "America/Los_Angeles"
      },
      "expected": "2026-03-08"
    },
    {
      "name": "LA 01:30 PDT before the fall-back repeat",
      "fn": "localDayKey",
      "input": {
        "isoTimestamp": "2026-11-01T08:30:00Z",
        "timeZone": "America/Los_Angeles"
      },
      "expected": "2026-11-01"
    },
    {
      "name": "LA 01:30 PST after the fall-back repeat",
      "fn": "localDayKey",
      "input": {
        "isoTimestamp": "2026-11-01T09:30:00Z",
        "timeZone": "America/Los_Angeles"
      },
      "expected": "2026-11-01"
    },
    {
      "name": "LA 23:59 PST on the 25-hour day",
      "fn": "localDayKey",
      "input": {
        "isoTimestamp": "2026-11-02T07:59:00Z",
        "timeZone": "America/Los_Angeles"
      },
      "expected": "2026-11-01"
    },
    {
      "name": "UTC 23:59:59",
      "fn": "localDayKey",
      "input": {
        "isoTimestamp": "2026-10-10T23:59:59Z",
        "timeZone": "UTC"
      },
      "expected": "2026-10-10"
    },
    {
      "name": "UTC midnight",
      "fn": "localDayKey",
      "input": {
        "isoTimestamp": "2026-10-11T00:00:00Z",
        "timeZone": "UTC"
      },
      "expected": "2026-10-11"
    },
    {
      "name": "Kolkata 23:59 IST (UTC+05:30)",
      "fn": "localDayKey",
      "input": {
        "isoTimestamp": "2026-10-10T18:29:00Z",
        "timeZone": "Asia/Kolkata"
      },
      "expected": "2026-10-10"
    },
    {
      "name": "Kolkata 00:00 IST",
      "fn": "localDayKey",
      "input": {
        "isoTimestamp": "2026-10-10T18:30:00Z",
        "timeZone": "Asia/Kolkata"
      },
      "expected": "2026-10-11"
    },
    {
      "name": "LA: four nights at 23:30 across the spring-forward change, ranked today",
      "fn": "streakFromTimestamps",
      "input": {
        "timestamps": [
          "2026-03-07T07:30:00Z",
          "2026-03-08T07:30:00Z",
          "2026-03-09T06:30:00Z",
          "2026-03-10T06:30:00Z"
        ],
        "timeZone": "America/Los_Angeles",
        "now": "2026-03-10T06:45:00Z",
        "period": "day"
      },
      "expected": {
        "periodKeys": [
          "2026-03-06",
          "2026-03-07",
          "2026-03-08",
          "2026-03-09"
        ],
        "todayKey": "2026-03-09",
        "current": 4,
        "longest": 4,
        "lastKey": "2026-03-09"
      }
    },
    {
      "name": "LA: the 25-hour fall-back day, two rankings, alive from yesterday",
      "fn": "streakFromTimestamps",
      "input": {
        "timestamps": [
          "2026-10-31T19:00:00Z",
          "2026-11-01T07:30:00Z",
          "2026-11-02T07:30:00Z"
        ],
        "timeZone": "America/Los_Angeles",
        "now": "2026-11-02T18:00:00Z",
        "period": "day"
      },
      "expected": {
        "periodKeys": [
          "2026-10-31",
          "2026-11-01"
        ],
        "todayKey": "2026-11-02",
        "current": 2,
        "longest": 2,
        "lastKey": "2026-11-01"
      }
    },
    {
      "name": "LA: a ranking at 23:59 local keeps the streak, the next one at 00:01 extends it",
