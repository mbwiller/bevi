    {
      "name": "weekly: three ISO weeks across the new year",
      "fn": "streakFromTimestamps",
      "input": {
        "timestamps": [
          "2026-12-23T12:00:00Z",
          "2026-12-31T12:00:00Z",
          "2027-01-05T12:00:00Z"
        ],
        "timeZone": "UTC",
        "now": "2027-01-12T12:00:00Z",
