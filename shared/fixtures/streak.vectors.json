          "2026-10-03T12:00:00Z",
          "2026-10-09T12:00:00Z"
        ],
        "timeZone": "UTC",
        "now": "2026-10-11T12:00:00Z",
        "period": "day"
      },
      "expected": {
        "periodKeys": [
          "2026-10-01",
          "2026-10-02",
          "2026-10-03",
          "2026-10-09"
