      "input": {
        "timestamps": [
          "2026-10-09T18:00:00Z",
          "2026-10-11T06:59:00Z",
          "2026-10-11T07:01:00Z"
        ],
        "timeZone": "America/Los_Angeles",
        "now": "2026-10-11T20:00:00Z",
        "period": "day"
      },
      "expected": {
        "periodKeys": [
          "2026-10-09",
          "2026-10-10",
          "2026-10-11"
        ],
        "todayKey": "2026-10-11",
        "current": 3,
        "longest": 3,
        "lastKey": "2026-10-11"
      }
    },
    {
      "name": "UTC: the same instants as the previous case",
      "fn": "streakFromTimestamps",
      "input": {
        "timestamps": [
          "2026-10-09T18:00:00Z",
          "2026-10-11T06:59:00Z",
          "2026-10-11T07:01:00Z"
        ],
        "timeZone": "UTC",
        "now": "2026-10-11T20:00:00Z",
        "period": "day"
