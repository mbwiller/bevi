          "2026-10-11",
          "2026-10-11"
        ],
        "todayKey": "2026-10-11",
        "period": "day"
      },
      "expected": {
        "current": 2,
        "longest": 2,
        "lastKey": "2026-10-11"
      }
    },
    {
      "name": "across a month end and a leap day",
      "fn": "computeStreak",
      "input": {
        "periodKeys": [
          "2028-02-28",
          "2028-02-29",
          "2028-03-01"
        ],
        "todayKey": "2028-03-01",
        "period": "day"
      },
      "expected": {
        "current": 3,
        "longest": 3,
        "lastKey": "2028-03-01"
      }
    },
    {
      "name": "longest run earlier than the current one",
      "fn": "computeStreak",
      "input": {
        "periodKeys": [
