{
  "version": "1.0.0",
  "constants": {
    "version": "1.0.0",
    "bands": {
      "DISLIKED": [
        0,
        4
      ],
      "FINE": [
        4,
        7
      ],
      "LOVED": [
        7,
        10
      ]
    },
    "bucketOrder": [
      "LOVED",
      "FINE",
      "DISLIKED"
    ],
    "bucketDb": {
      "LOVED": 3,
      "FINE": 2,
      "DISLIKED": 1
    },
    "sigmaFloor": 1,
    "minNUser": 3,
    "minNCat": 3,
    "globalFallback": {
      "mean": 5,
      "stddev": 2.5
    },
    "kAff": 2,
    "bayesC": 3,
    "bayesCategoryPriorMin": 30,
    "minRaters": 2,
    "storedScoreRule": "cents = floor((2N + D) / (2D)) with D = n + 1, N = 100*(hi*D - (hi - lo)*(index + 1)); capped at hi*100 - 1 for FINE and DISLIKED; storedScore = cents / 100",
    "stddev": "population (stddev_pop)",
    "nameOrder": "code point (SQL collate \"C\"), then bevId"
  },
  "cases": [
    {
      "name": "empty bucket",
      "fn": "placement",
      "input": {
        "bevId": "new",
        "bucket": "LOVED",
        "orderedBevIds": [],
        "steps": []
      },
      "expected": {
        "bevId": "new",
        "bucket": "LOVED",
        "insertIndex": 0,
        "expectedBucketSize": 0,
        "comparisons": []
      }
    },
    {
      "name": "one Bev, new is better",
      "fn": "placement",
      "input": {
        "bevId": "new",
        "bucket": "FINE",
        "orderedBevIds": [
          "coke"
        ],
        "steps": [
          "NEW_BETTER"
        ]
      },
      "expected": {
        "bevId": "new",
        "bucket": "FINE",
        "insertIndex": 0,
        "expectedBucketSize": 1,
        "comparisons": [
          {
            "winnerBevId": "new",
            "loserBevId": "coke",
            "tie": false
          }
        ]
      }
    },
    {
      "name": "one Bev, existing is better",
      "fn": "placement",
      "input": {
        "bevId": "new",
        "bucket": "FINE",
        "orderedBevIds": [
          "coke"
        ],
        "steps": [
          "EXISTING_BETTER"
        ]
      },
      "expected": {
        "bevId": "new",
        "bucket": "FINE",
        "insertIndex": 1,
        "expectedBucketSize": 1,
        "comparisons": [
          {
            "winnerBevId": "coke",
            "loserBevId": "new",
            "tie": false
          }
        ]
      }
    },
    {
      "name": "one Bev, tie",
      "fn": "placement",
      "input": {
        "bevId": "new",
        "bucket": "FINE",
        "orderedBevIds": [
          "coke"
        ],
        "steps": [
          "TIE"
        ]
      },
      "expected": {
        "bevId": "new",
        "bucket": "FINE",
        "insertIndex": 1,
        "expectedBucketSize": 1,
        "comparisons": [
          {
            "winnerBevId": "coke",
            "loserBevId": "new",
            "tie": true
          }
        ]
      }
    },
