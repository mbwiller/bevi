{
  "version": "1.4.0",
  "constants": {
    "version": "1.4.0",
    "bands": {
      "DISLIKED": [
        0,
        4
      ],
      "FINE": [
        4,
        7
      ],
      "LOVED": [
        7,
        10
      ]
    },
    "bucketOrder": [
      "LOVED",
      "FINE",
      "DISLIKED"
    ],
    "bucketDb": {
      "LOVED": 3,
      "FINE": 2,
      "DISLIKED": 1
    },
    "sigmaFloor": 1,
    "minNUser": 3,
    "minNCat": 3,
    "globalFallback": {
      "mean": 5,
      "stddev": 2.5
    },
    "kAff": 2,
    "bayesC": 3,
    "bayesCategoryPriorMin": 30,
    "minRaters": 2,
    "kG": 3,
    "rankPointsWeights": {
      "bevsRanked": 1,
      "currentStreak": 3,
      "bevsCreated": 2
    },
    "streakPeriod": "day",
    "simWeights": {
      "category": 0.4,
      "brand": 0.3,
      "flavor": 0.2,
      "tier": 0.1
    },
    "simMin": 0.1,
    "layer1Weights": {
      "affinity": 0.4,
      "content": 0.4,
      "global": 0.2
    },
    "conf1UserN": 10,
    "conf1Mass": 4,
    "cfK": 10,
    "cfMinCommon": 2,
    "cfSignificance": 5,
    "lambdaMax": 0.7,
    "lambdaUserN": 15,
    "epsilon": 0.15,
    "jitterSd": 0.15,
    "edgeWeights": {
      "tree": 0.25,
      "content": 0.15,
      "emb": 0.3,
      "profile": 0.3,
      "cop": 0
    },
    "edgeTopK": 20,
    "edgeMinWeight": 0.3,
    "profileWeights": {
      "base": 0.4,
      "carbonated": 0.15,
      "dairy": 0.1,
      "alcohol": 0.05,
      "caffeine": 0.15,
      "sweetness": 0.15
    },
    "profileLevelSpan": 3,
    "tasteK": 2,
    "tasteMinAttrBevs": 2,
    "tasteAlpha": 0.5,
    "tasteSharedMin": 0.2,
    "tasteMinSharedAttrs": 2,
    "tasteBridgeKinds": [
      "brand",
      "flavor"
    ],
    "tasteSimFloor": 0.1,
    "tasteNeighbourK": 25,
    "neighbourReliabilityN": 15,
    "storedScoreRule": "cents = floor((2N + D) / (2D)) with D = n + 1, N = 100*(hi*D - (hi - lo)*(index + 1)); capped at hi*100 - 1 for FINE and DISLIKED; storedScore = cents / 100",
    "stddev": "population (stddev_pop)",
    "nameOrder": "Unicode code point, not UTF-16 code unit (SQL collate \"C\" on UTF-8), then bevId the same way",
    "streakDayKey": "calendar date of the ranking instant in the profile timezone: (created_at AT TIME ZONE timezone)::date; week = ISO week of that date (YYYY-Www)",
    "rankOrder": "points desc, bevsRanked desc, createdAt asc, userId asc; rank = 1 + count(points > mine); bevsRanked = 0 excluded",
    "treeDepth": "Wu-Palmer depth from an implicit root (depth 0) above the top-level categories; a top-level category (parent null or not in the taxonomy) has depth 1",
    "profileRule": "N / 300 with N = 3*(40*[base] + 15*[carbonated] + 10*[dairy] + 5*[alcohol]) + 15*(3 - |dCaffeine|) + 15*(3 - |dSweetness|)",
    "embeddingRule": "min(1, max(0, dot / sqrt(|a|^2 * |b|^2))); 0 when either vector is zero",
    "edgeWeightRule": "tree*0.25 + content*0.15 + emb*0.30 + profile*0.30 + cop*0, summed in that order, clamped to [0, 1]",
    "edgeOrder": "w desc, then bevId asc (code unit); keep w >= edgeMinWeight; at most edgeTopK",
    "pearsonRule": "r over common(u, v) = R(u) & R(v) in bevId order: sum((x - mean x)(y - mean y)) / sqrt(sum((x - mean x)^2) * sum((y - mean y)^2)), clamped to [-1, 1]; 0 when |common| < cfMinCommon or either side is constant (all entries equal); sim = r * min(1, |common| / cfSignificance)",
    "tasteAttributeKey": "'category:' + categoryId, 'brand:' + normaliseBrand(brand) when non-empty, 'flavor:' + trim(flavorBase) when non-empty; kept when it covers >= tasteMinAttrBevs catalog Bevs",
    "tasteVectorRule": "t_u[a] = sum of z_{u,b} over b in R(u) carrying a / (n_{u,a} + tasteK); Bevs outside the catalog skipped",
    "attributeSimilarityRule": "cosine of the taste vectors as sparse vectors (missing = 0), clamped to [-1, 1]; 0 when either is all zeros",
    "sharedAttrsRule": "count of attributes a of a tasteBridgeKinds kind with |t_u[a]| >= tasteSharedMin and |t_v[a]| >= tasteSharedMin that u and v reach through distinct Bevs: some b in R(u) and b2 in R(v) carry a with b != b2 (one co-rated Bev is not a bridge)",
    "blendRule": "alpha = tasteAlpha if |common| >= cfMinCommon else 0; attributeSim = attributeSimilarity if |common| >= cfMinCommon or sharedAttrs >= tasteMinSharedAttrs else 0; sim = alpha * pearson.sim + (1 - alpha) * attributeSim, clamped to [-1, 1]; method = attr (alpha 0), pearson (alpha 1), else blend",
    "neighbourOrder": "sim desc, then userId asc (code point, SQL collate \"C\"); keep sim >= tasteSimFloor; at most tasteNeighbourK",
    "reliabilityRule": "min(1, n_v / neighbourReliabilityN); applied by Layer 2 per neighbour, not stored in user_neighbors.sim",
    "bayesStoredRule": "bev_stats.bayes_score numeric(4,2) from exact inputs: m with at most 3 dp (global_stats.mean_score numeric(5,3), or the exact category mean), scores in cents; N = C*m_thousandths + 10*sum(score_cents), D = C + n; storedCents = round half away from zero of N / (10*D) = floor((2N + 10D) / (20D)); never round the floating-point bayes",
    "streakEvents": "streakFromTimestamps.timestamps are ranking EVENTS (submit_ranking and rerank_bev), never deleted: a re-rank adds its own day and keeps the original one; a removal adds and deletes nothing. When a case lists input.events, timestamps = events.map(at)",
    "layer1EdgesRule": "bevSimilarity 'edges': sim(b, b') = w of the snapshot.edges row for the unordered pair {b, b'} (either orientation), 0 when there is none; pairs with sim < simMin dropped as in 'content'; content = sum(sim * z) / (sum(sim) + 1); conf1 mass = n_{u,cat(b)} + sum(sim); affinity and g unchanged. A snapshot without an edges field (absent or null) uses contentSimilarity ('content'); an empty array means no edges"
  },
  "cases": [
    {
      "name": "empty bucket",
      "fn": "placement",
      "input": {
        "bevId": "new",
        "bucket": "LOVED",
        "orderedBevIds": [],
        "steps": []
      },
      "expected": {
        "bevId": "new",
        "bucket": "LOVED",
        "insertIndex": 0,
        "expectedBucketSize": 0,
        "comparisons": []
      }
    },
    {
      "name": "one Bev, new is better",
      "fn": "placement",
      "input": {
        "bevId": "new",
        "bucket": "FINE",
        "orderedBevIds": [
          "coke"
        ],
        "steps": [
          "NEW_BETTER"
        ]
      },
      "expected": {
        "bevId": "new",
        "bucket": "FINE",
        "insertIndex": 0,
        "expectedBucketSize": 1,
        "comparisons": [
          {
            "winnerBevId": "new",
            "loserBevId": "coke",
            "tie": false
          }
        ]
      }
    },
